printf '%s\n\n' 'Cursor (gpt-5) is reviewing the change. It'\''s done when its report shows here.'
'agent' -p --resume 'c1' --mode 'ask' --trust --workspace '/w' --model 'gpt-5' --output-format 'stream-json' --stream-partial-output 'Read your brief.' | 'tracks' review-stream --out '/r/report.md'
'tracks' hook --engine cursor --track t1 --reviewer r1 --reply-file '/r/report.md'
exec 'agent' --resume 'c1' --mode 'ask' --trust --workspace '/w' --model 'gpt-5'
